{
  "version": 2,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/whatsapp-webhook.js": {
      "maxDuration": 60
    },
    "api/check-emails.js": {
      "maxDuration": 60
    },
    "api/payment-webhook.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/check-overdue",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/appointment-reminder",
      "schedule": "0 6 * * *"
    }
  ]
}
