rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    // subcollections של users (tasks, team, clients וכו')
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /appointments/{apptId} {
      allow read, write: if true;
    }
    match /clients/{clientId} {
      allow read, write: if true;
    }
    // משימות משותפות מעסיק↔עובד
    match /sharedTasks/{taskId} {
      allow read, write: if true;
    }
    match /sharedTasks/{taskId}/{document=**} {
      allow read, write: if true;
    }
    match /pushSubscriptions/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
